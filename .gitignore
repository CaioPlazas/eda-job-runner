node_modules/
dist/
out/
*.vsix
.eda-runner/
.vscode-test/
*.log
# but keep the committed parser test fixtures (captured real tool output)
!test-fixtures/*.log
examples/**/build/
dsim_work/
dsim.env
metrics.db
examples/**/work/
transcript
vsim.wlf

# VeeR EH1 (examples/projects/veer-eh1) build byproducts -- regenerated by
# its own upstream Makefile every run, never committed. Scoped to that
# project's own paths so this doesn't swallow the vendored testbench/hex/*.hex
# fixtures the jobs actually run.
examples/projects/veer-eh1/obj_dir/
examples/projects/veer-eh1/snapshots/
examples/projects/veer-eh1/program.hex
examples/projects/veer-eh1/verilator-build
examples/projects/veer-eh1/*.csv
examples/projects/veer-eh1/veer.core

.claude/

# Local SystemVerilog language-server config -- editor tooling, not project source.
.slang/

# Visual-test harness output (scripts/render-webviews.mjs + screenshot-webviews.mjs) -- regenerated, not committed.
.webview-preview/

# Local scratch config written by the extension while testing it in this repo.
# The leading slash keeps this to the repo root -- the tracked sample configs
# under examples/.vscode/ and sample-projects/*/.vscode/ are unaffected.
# Also: these carry absolute local paths, which must never reach the public repo.
/.vscode/eda-jobs.json
/.vscode/eda-tools.json
